{
  "name": "doran",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "desktop": "npm run build && npm --prefix windows-app start",
    "build:windows": "npm run build && npm --prefix windows-app run build",
    "format": "prettier --write src tests vite.config.ts windows-app/*.cjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "prettier": "^3.6.2"
  }
}
